# GitHub personal access token (optional — raises rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Reddit OAuth app credentials (required — create app at reddit.com/prefs/apps, type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:ai-content-pipeline:v0.1 (by /u/your_username)

# Ollama base URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use
OLLAMA_MODEL=qwen3:8b

# SQLite database path
DB_PATH=pipeline.db

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# YouTube API
YOUTUBE_API_KEY=

# Brave Search API (free tier: brave.com/search/api)
BRAVE_API_KEY=
