# ── Research Sources ──────────────────────────────────────────────────────────

# GitHub personal access token (optional — raises rate limit from 60 to 5,000 req/hr)
# Get one at: github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Brave Search API (optional — adds web-wide AI news as a source)
# Free tier: 2,000 queries/month. Get key at: brave.com/search/api
BRAVE_API_KEY=

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for research, validation, scoring, and content generation
OLLAMA_MODEL=qwen3:8b

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite database file path
DB_PATH=pipeline.db

# ── Instagram (Meta Graph API) ────────────────────────────────────────────────

# Required for `uv run post` to publish carousels to Instagram
# Get from: developers.facebook.com → your app → Instagram Basic Display
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── YouTube ───────────────────────────────────────────────────────────────────

# Required for YouTube Community posts
# Get from: console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=
